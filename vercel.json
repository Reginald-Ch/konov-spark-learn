{
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(favicon.ico|favicon.png|apple-touch-icon.png|icon-192.png|og-image.jpg)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/(sitemap.xml|robots.txt)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/programs",
      "destination": "/classes",
      "permanent": true
    },
    {
      "source": "/ai-classes-for-kids-accra",
      "destination": "/classes",
      "permanent": true
    },
    {
      "source": "/summer-ai-tech-camp",
      "destination": "/classes",
      "permanent": true
    },
    {
      "source": "/machine-learning-for-kids",
      "destination": "/classes",
      "permanent": true
    },
    {
      "source": "/for-schools",
      "destination": "/classes",
      "permanent": true
    },
    {
      "source": "/ai-curriculum-support",
      "destination": "/classes",
      "permanent": true
    },
    {
      "source": "/teacher-training",
      "destination": "/classes",
      "permanent": true
    },
    {
      "source": "/youth-hackathons",
      "destination": "/ai-builder-sprint",
      "permanent": true
    },
    {
      "source": "/me-ai",
      "destination": "https://meaitech.com",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
